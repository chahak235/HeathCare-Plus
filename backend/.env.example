# Copy this to .env and fill in your values
NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=healthcare_plus

JWT_SECRET=your_jwt_secret

# Get a key at https://console.groq.com/keys. Powers the AI chat assistant,
# symptom triage and image analysis. Without it those features are unavailable.
GROQ_API_KEY=your_groq_api_key

# --- Appointments ---
# Bookings are confirmed instantly. Set to false to make doctors approve each one.
APPOINTMENT_AUTO_CONFIRM=true
# How many days ahead patients can book (default 90)
MAX_BOOKING_DAYS=90
# Clinic time zone offset from UTC in minutes (India = 330)
CLINIC_UTC_OFFSET_MINUTES=330
FRONTEND_URL=http://localhost:3000

# --- Google Calendar + Meet ---
# OAuth client from Google Cloud Console. Redirect URIs to add:
#   http://localhost:3005/oauth2callback  (for npm run google-auth)
#   http://localhost:3001/api/auth/google/callback  (doctors connecting their own calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Clinic Google account used when a doctor hasn't connected their own calendar.
# Get it by running: npm run google-auth
GOOGLE_PLATFORM_REFRESH_TOKEN=

# --- Email (confirmation emails to patient and doctor) ---
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
# Without these, emails go to a test inbox and do not reach real people.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional model overrides. These are the defaults.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b